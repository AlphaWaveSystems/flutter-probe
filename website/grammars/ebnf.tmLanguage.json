{
  "name": "ebnf",
  "scopeName": "source.ebnf",
  "patterns": [
    { "include": "#comment" },
    { "include": "#special-sequence" },
    { "include": "#string" },
    { "include": "#definition" },
    { "include": "#operator" },
    { "include": "#bracket" },
    { "include": "#identifier" }
  ],
  "repository": {
    "comment": {
      "begin": "\\(\\*",
      "end": "\\*\\)",
      "name": "comment.block.ebnf"
    },
    "special-sequence": {
      "match": "\\?[^?]*\\?",
      "name": "string.other.special-sequence.ebnf"
    },
    "string": {
      "patterns": [
        { "match": "\"[^\"]*\"", "name": "string.quoted.double.ebnf" },
        { "match": "'[^']*'", "name": "string.quoted.single.ebnf" }
      ]
    },
    "definition": {
      "match": "^(\\s*)([A-Za-z_][A-Za-z0-9_\\-]*)(\\s*)(::=|=)",
      "captures": {
        "2": { "name": "entity.name.function.ebnf" },
        "4": { "name": "keyword.operator.definition.ebnf" }
      }
    },
    "operator": {
      "match": "[|,;]|-(?=\\s)",
      "name": "keyword.operator.ebnf"
    },
    "bracket": {
      "match": "[\\[\\]{}()]",
      "name": "punctuation.definition.group.ebnf"
    },
    "identifier": {
      "match": "[A-Za-z_][A-Za-z0-9_\\-]*",
      "name": "variable.other.nonterminal.ebnf"
    }
  }
}
