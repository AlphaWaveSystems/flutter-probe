---
// The legal and company pages (terms, privacy, refunds, subprocessors, company, contact) in the shared frame, in English and in Spanish.
// The version, the effective date and the company's details come from src/data/legal.json, so every page states the same ones.
import Site from './Site.astro';
import legal from '../data/legal.json';

interface Props {
  title: string;
  description: string;
  path?: string;
  lang?: 'en' | 'es';
  other?: string; // the path of the same page in the other language
}
const { title, description, path, lang = 'en', other } = Astro.props;
const here = path ?? Astro.url.pathname;
const date = new Date(`${legal.effective}T00:00:00Z`).toLocaleDateString(lang === 'es' ? 'es-MX' : 'en-GB', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' });
const line = lang === 'es' ? `Versión ${legal.version}, vigente desde el ${date}` : `Version ${legal.version}, effective ${date}`;
---
<Site title={`${title} - FlutterProbe`} description={description} path={here} lang={lang} other={other}>
  <div class="prose" lang={lang}>
    <h1>{title}</h1>
    <p class="updated">{line}{other && <> &middot; <a href={other} hreflang={lang === 'es' ? 'en' : 'es'}>{lang === 'es' ? 'English version' : 'Versión en español'}</a></>}</p>
    <slot />
  </div>
</Site>
