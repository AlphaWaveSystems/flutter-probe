# The negative variants of probe-tests/widgets/pickers.probe: every test below asserts something WRONG, or crosses what the agent can do, and every one must FAIL.
# They show that the positive suite can fail, and why. This file does not end in .probe, so `probe test` never picks it up in a directory run. To run it:
#
#   cp probe-tests/negative/pickers.probe.expect-fail /tmp/pickers-negative.probe
#   probe test /tmp/pickers-negative.probe --device <serial> -y       # (the pickers build, the same probe.yaml as for pickers.probe)
#
# Expected: 0 passed, 15 failed, each with the message in its comment. A test that passes is a finding: either the agent changed or the positive suite no longer proves what it says.
# Each test must fail at its own step, with the message in its comment. A failure at the `wait until` of `before each test` (a timeout
# waiting for the screen's last element) is NOT the expected failure: the screen never showed, and the run proves nothing.

before each test
  restart the app
  # Right after a restart the agent can answer while the screen is still being built (issue #793): wait for the screen's last element with an id.
  wait until #wf_icon_menu_state appears

# Expected: see "Blue": Expected to see "text("Blue")" but it was not found (the items of a closed dropdown are not in the tree)
test "N1 the items of a closed dropdown are not seen"
  see "Blue"

# Expected: tap "Green": Widget not found: text("Green") (nothing to tap: the menu is closed and the button shows the hint)
test "N2 an item of a closed dropdown is not tapped"
  tap "Green"

# Expected: see "Color: Blue": Expected to see "text("Color: Blue")" but it was not found (Green was chosen)
test "N3 the value is the item that was chosen"
  tap #wf_dropdown
  tap "Green"
  see "Color: Blue"

# Expected: see "Cut": Expected to see "text("Cut")" but it was not found (the items of a closed popup menu are not in the tree)
test "N4 the items of a closed popup menu are not seen"
  see "Cut"

# Expected: see "Spare": Expected to see "text("Spare")" but it was not found (a tap on a disabled dropdown opens nothing)
test "N5 a disabled dropdown does not open"
  tap #wf_dropdown_off
  see "Spare"

# Expected: see "Never shown": Expected to see "text("Never shown")" but it was not found (a tap on a disabled popup menu opens nothing)
test "N6 a disabled popup menu does not open"
  tap #wf_popup_off
  see "Never shown"

# Expected: see "Blue": Expected to see "text("Blue")" but it was not found (go back closed the dropdown and the wait for it to disappear passed)
test "N7 the items are gone after go back"
  tap #wf_dropdown
  wait until "Blue" appears
  go back
  wait until "Blue" disappears
  see "Blue"

# Expected: see "Item taps: 2": Expected to see "text("Item taps: 2")" but it was not found (one item was tapped once)
test "N8 the item counter counts the taps on items"
  tap #wf_dropdown
  tap "Green"
  see "Item taps: 2"

# Expected: see "Cut": Expected to see "text("Cut")" but it was not found (the tap on "Actions" under the open dropdown landed on the barrier and opened no popup menu)
test "N9 a button under an open dropdown is not pressed by a tap"
  tap #wf_dropdown
  wait until "Blue" appears
  tap "Actions"
  wait until "Blue" disappears
  see "Cut"

# Expected: tap #wf_nowhere: Widget not found: #wf_nowhere
test "N10 an id that is not on the screen"
  tap #wf_nowhere

# Expected: see #wf_dropdown_off is disabled: "#wf_dropdown_off" is enabled (KNOWN GAP, issue #864: this step is RIGHT and fails today, because the agent does not read a DropdownButton; when it is fixed this test passes, which is a finding: move it to pickers.probe)
test "N11 KNOWN GAP: a disabled dropdown is read as enabled, id on the control"
  see #wf_dropdown_off is disabled

# Expected: see #wf_dropdown_off_w is disabled: "#wf_dropdown_off_w" is enabled (KNOWN GAP, issue #864: this step is RIGHT and fails today; the id is on a wrapper only)
test "N12 KNOWN GAP: a disabled dropdown is read as enabled, id on a wrapper"
  see #wf_dropdown_off_w is disabled

# Expected: see #wf_popup_off is disabled: "#wf_popup_off" is enabled (KNOWN GAP, issue #864: this step is RIGHT and fails today, because the agent does not read a PopupMenuButton)
test "N13 KNOWN GAP: a disabled popup menu is read as enabled"
  see #wf_popup_off is disabled

# Expected: see #wf_dropdown contains "Pick a color": "#wf_dropdown" contains "", not "Pick a color" (by design: `#id contains` reads the text of the matched widget itself, and a DropdownButton is not a Text: read it by its text, `see "Pick a color"`)
test "N14 the text of a dropdown is not read through its id"
  see #wf_dropdown contains "Pick a color"

# Expected: see #wf_popup contains "Actions": "#wf_popup" contains "", not "Actions" (by design, as N14)
test "N15 the text of a popup menu button is not read through its id"
  see #wf_popup contains "Actions"
