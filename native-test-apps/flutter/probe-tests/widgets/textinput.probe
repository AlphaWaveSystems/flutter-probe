# Needs the text input build: flutter build apk --debug --dart-define=PROBE_AGENT=true --dart-define=PROBE_FIXTURE_WIDGETS=textinput (see README).
# What each test shows is also in docs/compat/MATRIX.md: a matrix cell is set only from a test that ran.

before each test
  restart the app
  # Right after a restart the agent can answer while the screen is still being built (issue #793): wait for the screen's last element
  # with an id. `wait until ... appears` matches only what is on screen, so this needs a screen tall enough to show that element
  # (measured on a Pixel 6 profile); on a shorter one the wait would time out. A wait for an earlier element was not enough (measured).
  wait until #wf_cupertino_state appears

test "a plain text field takes typed text and can be cleared"
  see "Plain: (empty)"
  type "hello" into #wf_textfield
  see "Plain: hello"
  clear #wf_textfield
  see "Plain: (empty)"

test "a form field shows its validation error until it has text"
  see "Form error: none"
  tap "Validate"
  see "Form error: Required"
  type "x" into #wf_formfield
  tap "Validate"
  see "Form error: none"

# The value of an obscured field is never a match target: `don't see "secret"` is a real check here, because with an older probe_agent (before this was
# a rule) `see "secret"` found the field by the text it holds. The field itself is still found by its id.
test "a password field takes typed text and its value is not searchable"
  type "secret" into #wf_password
  see "Password length: 6"
  see #wf_password
  don't see "secret"
  don't see "sec"

test "a multi-line field takes typed text"
  type "line one" into #wf_multiline
  see "Lines: 1"

test "a Cupertino text field takes typed text"
  type "hello" into #wf_cupertino_field
  see "Cupertino: hello"

# `see #id is filled` and `is empty` say whether a text field holds a character, and nothing about the text. They need a probe_agent that reports the see_filled capability.
test "a field is empty, filled by typing, and empty again after clear"
  see #wf_textfield is empty
  don't see #wf_textfield is filled
  type "x" into #wf_textfield
  see #wf_textfield is filled
  don't see #wf_textfield is empty
  clear #wf_textfield
  see #wf_textfield is empty

test "spaces are characters: a field of spaces is filled"
  type "   " into #wf_textfield
  see #wf_textfield is filled
  don't see #wf_textfield is empty

# The check works on a password field too, and the value is never in the answer: the step passes or fails on the length alone.
test "a password field is empty, then filled, then empty, without its value being read"
  see #wf_password is empty
  type "secret" into #wf_password
  see #wf_password is filled
  don't see #wf_password is empty
  see "Password length: 6"
  clear #wf_password
  see #wf_password is empty
  see "Password length: 0"

test "a form field, a multi-line field and a Cupertino field are fields too"
  see #wf_formfield is empty
  type "x" into #wf_formfield
  see #wf_formfield is filled
  see #wf_multiline is empty
  type "line one" into #wf_multiline
  see #wf_multiline is filled
  see #wf_cupertino_field is empty
  type "hello" into #wf_cupertino_field
  see #wf_cupertino_field is filled

# Below the fold: a space of a screen height plus 600 dp and then one widget. A ListView builds only the children near the viewport, so the widget is not in the tree until a scroll reaches it.
test "a field below the fold: scroll to it, type into it, scroll back"
  don't see #wf_bottom_field
  scroll down until #wf_bottom_field appears
  see #wf_bottom_field is empty
  type "end" into #wf_bottom_field
  see "Lower field: end"
  see #wf_bottom_field is filled
  scroll up until #wf_textfield appears
