# Converted from Maestro — app: ${APP_ID}

test "migrated flow"
  use "../../helpers/clear-state.yaml"
  wait until "Login to NECT" appears
  tap on #login_forgot_password_link
  wait until "Send Reset Link" appears
  see #forgot_password_back_to_login_button
  tap on #forgot_password_back_to_login_button
  wait until "Login to NECT" appears
  take a screenshot called "forgot-password-back-to-login"
  tap on #login_forgot_password_link
  wait until "Send Reset Link" appears
  tap on #forgot_password_email_field
  type "${TEST_EMAIL}"
  tap on #forgot_password_send_button
  wait until "Check Your Email" appears
  see "${TEST_EMAIL}"
  see #forgot_password_resend_button
  take a screenshot called "forgot-password-success-state"
  tap on #forgot_password_resend_button
  wait until "Reset link resent!" appears
  take a screenshot called "forgot-password-resend-confirmed"
  tap on #forgot_password_back_to_login_button
  wait until "Login to NECT" appears
