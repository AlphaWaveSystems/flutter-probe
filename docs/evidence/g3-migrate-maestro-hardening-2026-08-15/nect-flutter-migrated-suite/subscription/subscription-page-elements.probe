# Converted from Maestro — app: ${APP_ID}

test "migrated flow"
  use "../../helpers/login.yaml"
  use "../../helpers/open-drawer.yaml"
  tap on #drawer_subscription_item
  wait until "Premium Subscription" appears
  see "Premium Subscription"
  take a screenshot called "subscription-page"
  wait until "No subscription offerings available at this time\\.|Subscribe Now" appears
  take a screenshot called "subscription-offerings"
  see #subscription_restore_button
  tap on #subscription_restore_button
  wait for the page to load
  take a screenshot called "subscription-restore-result"
  tap on #subscription_back_button
