# Converted from Maestro — app: ${APP_ID}

test "migrated flow"
  use "../../helpers/login.yaml"
  use "../../helpers/open-drawer.yaml"
  tap on #drawer_communities_item
  wait until "My Communities" appears
  tap on #group_card_0
  wait until "Actions" appears
  take a screenshot called "count-verify-before"
  tap on #reaction_button_heart
  wait for the page to load
  see #reaction_count_heart
  take a screenshot called "count-verify-heart-active"
  tap on #reaction_button_heart
  wait for the page to load
  take a screenshot called "count-verify-heart-reset"
  tap on #reaction_button_thumbsUp
  wait for the page to load
  see #reaction_count_thumbsUp
  take a screenshot called "count-verify-thumbsup-active"
  tap on #reaction_button_thumbsUp
  wait for the page to load
  take a screenshot called "count-verify-thumbsup-reset"
  tap on #reaction_button_celebrate
  wait for the page to load
  see #reaction_count_celebrate
  take a screenshot called "count-verify-celebrate-active"
  tap on #reaction_button_celebrate
  wait for the page to load
  take a screenshot called "count-verify-after-reset"
