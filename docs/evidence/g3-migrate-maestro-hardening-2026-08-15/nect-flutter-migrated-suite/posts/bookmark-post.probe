# Converted from Maestro — app: ${APP_ID}

test "migrated flow"
  use "../../helpers/login.yaml"
  use "../../helpers/open-drawer.yaml"
  tap on #drawer_communities_item
  wait until "My Communities" appears
  tap on #group_card_0
  wait until "Actions" appears
  take a screenshot called "bookmark-post-before"
  tap on #post_bookmark_button
  wait for the page to load
  take a screenshot called "bookmark-post-bookmarked"
  use "../../helpers/open-drawer.yaml"
  tap on #drawer_saved_posts_item
  wait until "Saved Posts" appears
  take a screenshot called "bookmark-post-saved-posts-page"
  go back
  tap on #post_bookmark_button
  wait for the page to load
  take a screenshot called "bookmark-post-unbookmarked"
