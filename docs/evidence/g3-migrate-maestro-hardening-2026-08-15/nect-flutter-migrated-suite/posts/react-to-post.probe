# Converted from Maestro — app: ${APP_ID}

test "migrated flow"
  use "../../helpers/login.yaml"
  use "../../helpers/open-drawer.yaml"
  tap on #drawer_communities_item
  wait until "My Communities" appears
  tap on #group_card_0
  wait until "Actions" appears
  take a screenshot called "react-to-post-before"
  tap on #reaction_button_heart
  wait for the page to load
  take a screenshot called "react-to-post-heart-active"
  tap on #reaction_button_heart
  wait for the page to load
  tap on #reaction_button_thumbsUp
  wait for the page to load
  take a screenshot called "react-to-post-thumbsup-active"
  tap on #reaction_button_thumbsUp
  wait for the page to load
  tap on #reaction_button_celebrate
  wait for the page to load
  take a screenshot called "react-to-post-celebrate-active"
  tap on #reaction_button_celebrate
  wait for the page to load
  take a screenshot called "react-to-post-after-reset"
