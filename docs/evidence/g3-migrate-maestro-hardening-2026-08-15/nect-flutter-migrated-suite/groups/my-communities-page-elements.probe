# Converted from Maestro — app: ${APP_ID}

test "migrated flow"
  use "../../helpers/login.yaml"
  use "../../helpers/open-drawer.yaml"
  tap on #drawer_communities_item
  wait until "My Communities" appears
  tap on #communities_search_button
  tap on #communities_search_field
  type "zzz_no_such_community_zzz"
  wait for the page to load
  wait until "No communities match your search." appears
  take a screenshot called "my-communities-elements-search-no-results"
  tap on #communities_search_button
  wait for the page to load
  don't see #communities_search_field
  take a screenshot called "my-communities-elements-search-cleared"
  take a screenshot called "my-communities-elements-fixture-card"
  tap on #group_card_options_button_0
  wait for the page to load
  take a screenshot called "my-communities-elements-options-sheet"
  tap on #community_options_set_default_item
  take a screenshot called "my-communities-elements-set-default-result"
  tap on #group_card_options_button_0
  wait for the page to load
  tap on #community_options_delete_item
  wait for the page to load
  take a screenshot called "my-communities-elements-delete-dialog"
  tap on "Cancel"
  wait for the page to load
  take a screenshot called "my-communities-elements-delete-cancelled"
