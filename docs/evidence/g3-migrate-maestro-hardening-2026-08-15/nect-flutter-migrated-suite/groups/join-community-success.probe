test "migrated flow"
  tap on #appbar_menu_button
  wait for the page to load
  tap on #drawer_communities_item
  wait until "My Communities" appears
  tap on #my_communities_fab
  wait for the page to load
  tap on #fab_join_community
  tap on #join_group_code_field
  type "YXozd9ZPGZQL4SFIpoA5"
  tap on #join_group_confirm_button
  wait until "Successfully joined E2E Test Community|E2E Test Community" appears
  take a screenshot called "join-community-success"
  tap on #info_dialog_got_it_button
